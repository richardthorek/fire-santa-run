{
  "name": "fire-santa-run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:storage\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:storage": "azurite-table --silent --skipApiVersionCheck",
    "dev:server": "cd server && DEV_MODE=true npm run dev",
    "dev:e2e": "concurrently \"npm:dev:storage\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "setup": "npm install && (cd server && npm install)",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:a11y": "vitest run src/__tests__/accessibility.test.ts src/__tests__/AppHeader.a11y.test.tsx src/__tests__/LaunchPages.a11y.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/smoke-test.js",
    "test:load": "node scripts/load-test.js",
    "test:mobile-guide": "node scripts/mobile-testing-guide.js",
    "report:upcoming-runs": "node scripts/upcoming-runs-report.js",
    "audit:a11y": "npm run test:a11y && echo '✅ Accessibility tests passed'",
    "audit:lighthouse": "node scripts/lighthouse-audit.js",
    "audit:perf": "npm run build && concurrently --kill-others --success first \"npm run preview\" \"node scripts/lighthouse-audit.js\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@simplewebauthn/browser": "^13.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "mapbox-gl": "^3.25.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.9.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/axe-core": "^3.0.6",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.1",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.16",
    "axe-core": "^4.11.0",
    "azurite": "^3.37.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "terser": "^5.48.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  }
}
