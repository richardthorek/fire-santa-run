{
  "name": "fire-santa-run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:storage\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:storage": "azurite-table --silent --skipApiVersionCheck",
    "dev:server": "cd server && DEV_MODE=true npm run dev",
    "dev:e2e": "concurrently \"npm:dev:storage\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "setup": "npm install && (cd server && npm install)",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:a11y": "vitest run src/__tests__/accessibility.test.ts src/__tests__/AppHeader.a11y.test.tsx src/__tests__/LaunchPages.a11y.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/smoke-test.js",
    "test:load": "node scripts/load-test.js",
    "test:mobile-guide": "node scripts/mobile-testing-guide.js",
    "report:upcoming-runs": "node scripts/upcoming-runs-report.js",
    "audit:a11y": "npm run test:a11y && echo '✅ Accessibility tests passed'",
    "audit:lighthouse": "node scripts/lighthouse-audit.js",
    "audit:perf": "npm run build && concurrently --kill-others --success first \"npm run preview\" \"node scripts/lighthouse-audit.js\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@simplewebauthn/browser": "^14.0.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.44.0",
    "mapbox-gl": "^3.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/axe-core": "^3.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.2",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "axe-core": "^4.11.0",
    "azurite": "^3.37.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
