{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(az ad app federated-credential create --id de0383f9-6164-48a9-a667-3217bdbf6e35 --parameters '{ *)",
      "Bash(az containerapp *)",
      "Bash(git add *)",
      "Bash(git commit -m 'chore: automate secret seeding in CI/CD workflow *)",
      "Bash(curl -s __TRACKED_VAR__/api/health)",
      "Bash(git commit -m '*)",
      "Bash(git commit -m 'fix: explicitly serve manifest.json and registerSW.js before SPA fallback *)",
      "Bash(git commit -m 'fix: remove manual CodeQL step, use GitHub default security setup *)"
    ],
    "deny": [
      "Read(package-lock.json)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(/dist/**)",
      "Read(/api/dist/**)",
      "Read(/server/dist/**)",
      "Read(/coverage/**)",
      "Read(**/node_modules/**)",
      "Read(/lighthouse-report*)",
      "Read(/lighthouse-reports/**)",
      "Read(**/*.report.json)",
      "Read(**/*.report.html)",
      "Read(/public/splash/**)",
      "Read(**/*.png)",
      "Read(/infra/**/*.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/local.settings.json)"
    ]
  }
}
