{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(package-lock.json)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(/dist/**)",
      "Read(/api/dist/**)",
      "Read(/server/dist/**)",
      "Read(/coverage/**)",
      "Read(**/node_modules/**)",
      "Read(/lighthouse-report*)",
      "Read(/lighthouse-reports/**)",
      "Read(**/*.report.json)",
      "Read(**/*.report.html)",
      "Read(/public/splash/**)",
      "Read(**/*.png)",
      "Read(/infra/**/*.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/local.settings.json)"
    ]
  }
}
