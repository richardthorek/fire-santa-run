# Fire Santa Run — App Service secrets template
#
# Copy this to infra/.env.dev and/or infra/.env.prod and fill in the values.
# Those files are GITIGNORED — never commit real keys.
#
# seed-secrets.sh (and deploy.sh, which calls it) loads infra/.env.<env> and
# seeds these into the App Service. Storage + Web PubSub connection strings are
# read live from Azure and do NOT belong here. Any value set in your shell env
# overrides the file, so CI can inject secrets without a file present.
#
#   cp infra/.env.example infra/.env.dev     # then edit
#   ./infra/seed-secrets.sh --env dev --dry-run
#   ./infra/seed-secrets.sh --env dev

# Stripe secret key — TEST key (sk_test_...) for dev, LIVE key (sk_live_...) for prod.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) for the endpoint pointing at
# https://<origin>/api/stripe/webhook. Use the test-mode secret for dev, live for prod.
STRIPE_WEBHOOK_SECRET=

# Stripe recurring price id for the $5/yr brigade subscription.
# Dev = a TEST-mode price (price_...); prod = the LIVE price (price_1TqY7VJICayKeHpbTDOz641J).
STRIPE_PRICE_ID=

# Set to 'true' to add GST to checkout via Stripe Tax and produce a compliant
# tax invoice. Requires Stripe Tax to be activated in the dashboard first —
# leave blank/false until then, or Checkout will error. Brigade ABN capture and
# billing-address collection are always on regardless of this flag.
STRIPE_AUTOMATIC_TAX=

# Comma-separated Entra/CIAM object ids (oid) granted site-admin privileges.
SITE_ADMIN_USER_IDS=

# Web Push ("notify me when Santa starts") — OPTIONAL. When unset, the tracking
# page simply hides the notify button. Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent to push services (optional; defaults to a mailto).
VAPID_SUBJECT=

# Optional: override the public origin used for CORS_ORIGIN / APP_BASE_URL.
# Defaults: prod -> https://firesantarun.com.au, dev -> https://santarun-web-<suffix>.azurewebsites.net
# APP_ORIGIN=
