# =============================================================================
# DEVELOPMENT MODE CONFIGURATION
# =============================================================================
# Set to 'true' for local development
# Set to 'false' for production (requires authentication and Azure services)
VITE_DEV_MODE=true

# Mock Brigade ID for Development Mode
# Used to simulate a brigade context without authentication
VITE_MOCK_BRIGADE_ID=dev-brigade-1
VITE_MOCK_BRIGADE_NAME="Development Fire Brigade"

# =============================================================================
# MAPBOX CONFIGURATION (Required for all modes)
# =============================================================================
# Get your token at https://account.mapbox.com/
# Scopes needed: styles:read, fonts:read, geocoding:read, directions:read
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# =============================================================================
# DEVELOPMENT WITH REAL STORAGE (Optional)
# =============================================================================
# If you want to use real Azure Table Storage in dev mode instead of localStorage,
# provide the Azure connection string below. Dev mode will automatically:
# - Detect the presence of Azure credentials
# - Switch from localStorage to Azure Table Storage
# - Prefix all table names with 'dev' (e.g., 'devroutes', 'devbrigades')
# - Keep your dev data separate from production data
#
# To use localStorage only (default): Leave VITE_AZURE_STORAGE_CONNECTION_STRING empty or commented
# To use Azure in dev mode: Uncomment and set VITE_AZURE_STORAGE_CONNECTION_STRING below
#
# VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_dev_account;AccountKey=your_dev_key;EndpointSuffix=core.windows.net

# =============================================================================
# PRODUCTION CONFIGURATION (Only required when VITE_DEV_MODE=false)
# =============================================================================

# Azure Storage Configuration
# Get connection string from Azure Portal > Storage Account > Access Keys
# In production, this uses tables without prefix (e.g., 'routes', 'brigades')
# VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# VITE_AZURE_STORAGE_ACCOUNT_NAME=your_account_name

# Microsoft Entra External ID Configuration
# Get these from Azure Portal > Entra External ID > App Registrations
# See docs/ENTRA_EXTERNAL_ID_SETUP.md for complete setup instructions
#
# Tenant Information (already created):
# - Name: Brigade Santa Run
# - Tenant ID: 50fcb752-2a4e-4efd-bdc2-e18a5042c5a8
# - Domain: brigadesantarun.onmicrosoft.com
#
# Required for production mode (VITE_DEV_MODE=false):
VITE_ENTRA_CLIENT_ID=your_client_id_from_app_registration
VITE_ENTRA_TENANT_ID=50fcb752-2a4e-4efd-bdc2-e18a5042c5a8
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/50fcb752-2a4e-4efd-bdc2-e18a5042c5a8
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Server-side (App Service / Hono backend) ---
# These are NOT VITE_-prefixed: they are read by the backend (server/ and api/),
# never exposed to the browser. Required in production (DEV_MODE=false).
#
# Azure Table Storage (FATAL if missing in production — data persistence):
AZURE_STORAGE_CONNECTION_STRING=
#
# Real-time Service (Web PubSub — required for live location broadcasting):
AZURE_WEBPUBSUB_CONNECTION_STRING=
AZURE_WEBPUBSUB_HUB_NAME=santa_tracking
#
# Site administrators allowed to review/approve brigade verification requests.
# Comma-separated Entra user IDs in `oid.tid` form (the SPA's homeAccountId).
# Leave empty to disable the admin-verification endpoints entirely in production
# (in DEV_MODE the mock user is always treated as a site admin).
SITE_ADMIN_USER_IDS=

# =============================================================================
# OG IMAGE GENERATION (Optional - enhances social media previews)
# =============================================================================
# Server-side Mapbox token for embedding map thumbnails in OG preview images.
# Uses the same Mapbox account as VITE_MAPBOX_TOKEN but runs on the API side.
# When omitted, OG images are generated without a map thumbnail.
# MAPBOX_TOKEN=pk.your_mapbox_token_here

# Azure Blob Storage connection string for caching generated OG images.
# When omitted, OG images are regenerated on every request (no caching).
# AZURE_BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
VITE_APP_NAME="Fire Santa Run"
VITE_APP_URL=https://your-domain.com

# =============================================================================
# QUICK START GUIDE
# =============================================================================
# For local development, you only need:
# 1. VITE_DEV_MODE=true
# 2. VITE_MAPBOX_TOKEN=pk.your_token_here
#
# Optional: Add Azure credentials to test with real storage in dev mode
# (data will be isolated with 'dev' prefix)
#
# All other variables are optional until you're ready for production deployment.
# Copy this file to .env.local and fill in your Mapbox token to get started!
# =============================================================================
